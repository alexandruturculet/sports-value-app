# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.

# The Odds API — https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# API-Football (v3) — https://api-football.com
FOOTBALL_API_KEY=your_api_football_key_here

# football-data.org (v4) — https://www.football-data.org
football-data-api-key=your_football_data_key_here
